# ==============================================================================
# CodeQuest Environment Configuration
# Copy this file to .env and fill in your keys
# ==============================================================================

# 1. Supabase (Database, Auth, & Storage)
# Found in: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Judge0 Online Compiler API
# For public cloud: https://judge0-ce.p.rapidapi.com or self-hosted http://localhost:2358
VITE_JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
VITE_JUDGE0_API_KEY=your_rapidapi_or_judge0_key
VITE_JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# 3. Stripe Payments (Subscriptions)
# Found in: Stripe Dashboard -> Developers -> API Keys
VITE_STRIPE_PUBLIC_KEY=pk_test_...
VITE_STRIPE_PRO_PRICE_ID=price_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
